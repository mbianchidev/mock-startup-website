{
  "name": "mock-startup-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "build": "next build && node scripts/validate-static-redirects.cjs",
    "images:optimize": "node scripts/optimize-images.cjs",
    "start": "next start",
    "lint": "eslint .",
    "test:playwright": "playwright test",
    "test:screenshots": "playwright test --headed"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "gray-matter": "^4.0.3",
    "next": "^15.5.20",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.20",
    "sharp": "0.35.3",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "$sharp"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.11.1": true
  }
}
